{
  "info": {
    "name": "The Antique Room – Authenticate",
    "description": "Tests the `authenticate` mutation: login if the member exists, signup if not.\n\nRun the Phone folder in order (Signup -> Login -> Wrong password).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Phone",
      "item": [
        {
          "name": "Signup (new phone)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh phone + nick for every run, so this always tests SIGNUP",
                  "const n = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('phone', '010' + n);",
                  "pm.collectionVariables.set('nick', 'zik' + n.slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No GraphQL errors', () => pm.expect(res.errors, JSON.stringify(res.errors)).to.be.undefined);",
                  "pm.test('Returns access token', () => pm.expect(res.data.authenticate.accessToken).to.be.a('string'));",
                  "pm.test('Password is never returned', () => pm.expect(res.data.authenticate.member).to.not.have.property('memberPassword'));",
                  "pm.collectionVariables.set('accessToken', res.data.authenticate.accessToken);",
                  "pm.collectionVariables.set('memberId', res.data.authenticate.member._id);",
                  "pm.test('Signed up with PHONE', () => pm.expect(res.data.authenticate.member.memberAuth).to.eql('PHONE'));",
                  "pm.collectionVariables.set('firstMemberId', res.data.authenticate.member._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Authenticate($input: AuthenticationInput!) {\n  authenticate(input: $input) {\n    accessToken\n    member {\n      _id\n      memberNick\n      memberType\n      memberAuth\n      memberStatus\n      memberPhone\n      memberEmail\n      memberImage\n      googleId\n      appleId\n      telegramId\n      expertProfile { specialties credentialsDesc yearsOfExperience verificationStatus }\n      createdAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"memberAuth\": \"PHONE\",\n    \"memberPhone\": \"{{phone}}\",\n    \"memberPassword\": \"{{password}}\",\n    \"memberNick\": \"{{nick}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "New phone number -> creates a member and returns a token."
          }
        },
        {
          "name": "Login (same phone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('No GraphQL errors', () => pm.expect(res.errors, JSON.stringify(res.errors)).to.be.undefined);",
                  "pm.test('Returns access token', () => pm.expect(res.data.authenticate.accessToken).to.be.a('string'));",
                  "pm.test('Password is never returned', () => pm.expect(res.data.authenticate.member).to.not.have.property('memberPassword'));",
                  "pm.collectionVariables.set('accessToken', res.data.authenticate.accessToken);",
                  "pm.collectionVariables.set('memberId', res.data.authenticate.member._id);",
                  "pm.test('Same member as signup (login, not a new account)', () => pm.expect(res.data.authenticate.member._id).to.eql(pm.collectionVariables.get('firstMemberId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Authenticate($input: AuthenticationInput!) {\n  authenticate(input: $input) {\n    accessToken\n    member {\n      _id\n      memberNick\n      memberType\n      memberAuth\n      memberStatus\n      memberPhone\n      memberEmail\n      memberImage\n      googleId\n      appleId\n      telegramId\n      expertProfile { specialties credentialsDesc yearsOfExperience verificationStatus }\n      createdAt\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"memberAuth\": \"PHONE\",\n    \"memberPhone\": \"{{phone}}\",\n    \"memberPassword\": \"{{password}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Same phone again -> logs in the existing member. Run 'Signup' first."
